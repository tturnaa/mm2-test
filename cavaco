--==================== CLICK ====================
local function clickAt(obj)
    if not obj or not obj:IsA("GuiObject") then return false end
    local s = obj.AbsoluteSize
    if s.X < 2 or s.Y < 2 then return false end
    local inset = GuiService:GetGuiInset()
    local p = obj.AbsolutePosition
    local x = math.floor(p.X + s.X/2 + inset.X)
    local y = math.floor(p.Y + s.Y/2 + inset.Y)

    if firesignal then
        pcall(function() firesignal(obj.MouseButton1Click) end)
        pcall(function() firesignal(obj.Activated) end)
    end
    pcall(function()
        VirtualInputManager:SendMouseMoveEvent(x, y, game)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    return true
end

local function resolve(path)
    local cur = playerGui
    for _, n in ipairs(path) do
        if not cur then return nil end
        if type(n) == "function" then cur = n(cur)
        else cur = cur:FindFirstChild(n) end
    end
    return cur
end

