--==================== BEACON PARSER ====================
local function parseServerBeacon(content)
    if not content or type(content) ~= "string" then return nil end

    local bot, placeId, jobId, userId = content:match(
        "SERVER|([^|]+)|PlaceId=(%d+)|JobId=([%w%-_]+)|UserId=(%d+)")
    if bot and jobId then
        if bot:lower() ~= BOT_USERNAME:lower() then return nil end
        return {
            placeId = tonumber(placeId),
            jobId = jobId,
            userId = userId and tonumber(userId) or nil,
        }
    end

    bot, placeId, jobId = content:match(
        "SERVER|([^|]+)|PlaceId=(%d+)|JobId=([%w%-_]+)")
    if not bot or not jobId then return nil end
    if bot:lower() ~= BOT_USERNAME:lower() then return nil end
    return { placeId = tonumber(placeId), jobId = jobId, userId = nil }
end

local function findBot()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == BOT_USERNAME:lower() then return p end
    end
end

--==================== TELEPORT ====================
local function teleportToServer(placeId, jobId, userId)
    log("=== TELEPORT START ===")
    log("placeId:", placeId, "jobId:", jobId, "userId:", tostring(userId))

    log("queueing autoexec...")
    local queued = queueAutoExec()
    log("queue result:", queued)
    task.wait(0.5)

    log("attempting TeleportToPlaceInstance...")
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
    end)

    if ok then
        log("TeleportToPlaceInstance SUCCEEDED")
        return true
    end
    log("TeleportToPlaceInstance FAILED:", tostring(err))

    if TeleportService.TeleportAsync then
        log("attempting TeleportAsync fallback...")
        local ok2, err2 = pcall(function()
            TeleportService:TeleportAsync(placeId, { player }, { JobId = jobId })
        end)
        if ok2 then
            log("TeleportAsync SUCCEEDED")
            return true
        end
        log("TeleportAsync FAILED:", tostring(err2))
    end

    log("=== TELEPORT FAILED (both methods) ===")
    return false
end

--==================== JOIN (self-verifying) ====================
local function joinTargetServer()
    log("=== JOIN START ===")
    kvSet("client_ask", "ASK")

    log("waiting for bot_reply (15s)...")
    local endT = tick() + 15
    while tick() < endT do
        if KILLED then return false end
        local reply = kvGet("bot_reply")
        if reply and reply ~= "" and type(reply) == "string" then
            log("  got reply:", reply)
            kvSet("bot_reply", "")
            break
        end
        task.wait(1)
    end

    log("polling for beacon (30s)...")
    endT = tick() + 30
    local attempt = 0
    while tick() < endT do
        if KILLED then return false end
        attempt = attempt + 1

        local status = kvGet("bot_status")
        log("  attempt " .. attempt .. " | bot_status:", tostring(status))

        if status == "OPEN" then
            local beacon = kvGet("roblox_beacon")
            log("  beacon:", tostring(beacon))

            if beacon and beacon ~= "" then
                local info = parseServerBeacon(beacon)
                if not info then
                    log("  beacon parse FAILED. Raw:", beacon)
                else
                    log("  parsed placeId=" .. tostring(info.placeId) ..
                        " jobId=" .. tostring(info.jobId) ..
                        " userId=" .. tostring(info.userId))

                    if info.jobId == game.JobId then
                        log("  already in bot's server")
                        return true
                    end

                    -- wait 1s and re-read beacon in case the bot hopped
                    task.wait(1)
                    local beacon2 = kvGet("roblox_beacon")
                    local info2 = parseServerBeacon(beacon2)
                    if info2 and info2.jobId ~= info.jobId then
                        log("  bot hopped during check! new jobId:", info2.jobId)
                        info = info2
                    end

                    local ok = teleportToServer(info.placeId, info.jobId, info.userId)
                    log("  teleport result:", ok)

                    if ok then
                        log("  verifying join (up to 20s)...")
                        local verifyEnd = tick() + 20
                        local joined = false
                        while tick() < verifyEnd do
                            if KILLED then return false end
                            task.wait(1)
                            local currentBeacon = kvGet("roblox_beacon")
                            local currentInfo = parseServerBeacon(currentBeacon)
                            if currentInfo and currentInfo.jobId == game.JobId then
                                log("  confirmed: we are in bot's server now")
                                joined = true
                                break
                            end
                            if findBot() then
                                log("  confirmed: bot found in player list")
                                joined = true
                                break
                            end
                        end
                        if not joined then
                            log("  never landed in bot's server after teleport")
                            return false
                        end
                    end

                    return ok
                end
            else
                log("  beacon empty")
            end
        elseif status == "HOPPING" then
            log("  bot is hopping — waiting")
        elseif status == nil then
            log("  KV read returned nil")
        else
            log("  unknown bot_status:", tostring(status))
        end

        task.wait(SNIPE_POLL_INTERVAL)
    end

    log("=== JOIN FAILED (timeout) ===")
    return false
end

