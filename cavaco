--==================== BEACON PARSER ====================
local function parseServerBeacon(content)
    if not content or type(content) ~= "string" then return nil end

    local bot, placeId, jobId, userId = content:match(
        "SERVER|([^|]+)|PlaceId=(%d+)|JobId=([%w%-_]+)|UserId=(%d+)")
    if bot and jobId then
        if bot:lower() ~= BOT_USERNAME:lower() then return nil end
        return {
            placeId = tonumber(placeId),
            jobId = jobId,
            userId = userId and tonumber(userId) or nil,
        }
    end

    bot, placeId, jobId = content:match(
        "SERVER|([^|]+)|PlaceId=(%d+)|JobId=([%w%-_]+)")
    if not bot or not jobId then return nil end
    if bot:lower() ~= BOT_USERNAME:lower() then return nil end
    return { placeId = tonumber(placeId), jobId = jobId, userId = nil }
end

local function findBot()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == BOT_USERNAME:lower() then return p end
    end
end

