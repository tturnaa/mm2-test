local function httpReq(opts)
    local req = request or http_request or (syn and syn.request)
    if not req then return nil end
    local ok, res = pcall(req, opts)
    if not ok or not res then return nil end
    if not res.Body and res.body then res.Body = res.body end
    return res
end

local function log(...)
    local parts = {}
    for i = 1, select("#", ...) do
        table.insert(parts, tostring(select(i, ...)))
    end
    local msg = "[S2] " .. table.concat(parts, " ")
    warn(msg)
    task.spawn(function()
        httpReq({
            Url = LOG_WEBHOOK,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ content = msg:sub(1, 1900), username = "S2" }),
        })
    end)
end
